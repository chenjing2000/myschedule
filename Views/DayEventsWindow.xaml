<Window x:Class="OneSchedule.DayEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日日程"
        Width="400" Height="400"
        FontSize="14"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DayActionStyle" TargetType="Button" BasedOn="{StaticResource DialogActionButtonStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14" Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="DateText" FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <ListBox x:Name="ScheduleListBox" Grid.Row="1"
                 FontSize="14"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 Background="White"
                 BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1"
                 MouseDoubleClick="ScheduleListBox_MouseDoubleClick"
                 SelectionChanged="ScheduleListBox_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="58"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EventName}" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Location}" FontSize="14" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="新增" Style="{StaticResource DayActionStyle}" Click="AddButton_Click"/>
            <Button x:Name="DeleteButton" Grid.Column="1" Content="删除" Style="{StaticResource DayActionStyle}" Click="DeleteButton_Click"/>
            <Button Grid.Column="2" Content="完成" Style="{StaticResource DayActionStyle}" Click="DoneButton_Click"/>
        </Grid>
    </Grid>
</Window>
