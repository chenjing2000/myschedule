<Window x:Class="OneSchedule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OneSchedule"
        Title="MySchedule" Width="400" Height="460" MinWidth="380" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="PeriodChoiceStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Circle" CornerRadius="30" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.75"/>
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Circle" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Circle" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BarBrush}" Padding="14,10" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TodayButton" Content="今天" Style="{StaticResource CompactButtonStyle}" Click="TodayButton_Click" ToolTip="回到今天"/>
                    <Button x:Name="RefreshButton" Content="↻" FontSize="19" Style="{StaticResource CompactButtonStyle}" Click="RefreshButton_Click" ToolTip="刷新日程" AutomationProperties.Name="刷新日程"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TodaySolarText" FontSize="17"/>
                    <TextBlock x:Name="LunarInfoText" FontSize="14" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ReminderBar" Grid.Row="1" Background="{StaticResource AccentBrush}" Padding="8,5" Visibility="Collapsed" MouseLeftButtonDown="ReminderBar_MouseLeftButtonDown">
            <TextBlock x:Name="ReminderText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
        <Grid Grid.Row="2" Margin="10,4,10,6" PreviewMouseWheel="CalendarArea_MouseWheel">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,2">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PreviousButton" Content="▲" Width="36" Style="{StaticResource CompactButtonStyle}" Click="PreviousButton_Click"/>
                    <Button x:Name="NextButton" Content="▼" Width="36" Style="{StaticResource CompactButtonStyle}" Click="NextButton_Click"/>
                </StackPanel>
                <Button x:Name="PeriodButton" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Left"
                        Style="{StaticResource CompactButtonStyle}" Click="PeriodButton_Click"/>
            </DockPanel>
            <!-- 提醒/错误占用空间时提供滚动，不压扁日期圆；普通大小下无需滚动。 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="CalendarSurface" MinHeight="292" Background="{StaticResource SurfaceBrush}">
                    <local:CalendarView x:Name="Calendar" DayInvoked="Calendar_DayInvoked"/>
                    <ItemsControl x:Name="PeriodItems" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource BarBrush}" Padding="10,4" Visibility="Collapsed">
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
